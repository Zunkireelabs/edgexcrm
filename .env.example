# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_APP_URL=https://leads-crm.zunkireelabs.com

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxx

# Google OAuth (for Gmail send/reply-sync)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Gmail inbox token encryption (connected_email_accounts refresh/access tokens
# at rest) + Gmail poller reply-sync gate (Path B — dormant until flipped).
# INBOX_TOKEN_ENC_KEY=  # 32-byte hex (openssl rand -hex 32); fail-closed if unset.
# EMAIL_REPLY_SYNC_ENABLED=true

# EdgeX native email inbound spine (docs/email-productionization/INBOUND-SPINE-BRIEF.md).
# All fail-closed if unset — inbound mail is rejected rather than processed unverified.
# RESEND_INBOUND_WEBHOOK_SECRET=  # from Resend → Webhooks → the inbound endpoint's signing secret
# INBOUND_EMAIL_DOMAINS=lead-crm.zunkireelabs.com  # comma-separated list; first entry is where new addresses mint
# INBOUND_TOKEN_SECRET=  # 32-byte hex (openssl rand -hex 32); DIFFERENT per environment
# INBOUND_ENV_MARKER=l  # one char: l=local, s=stage, p=prod — stage/prod share one Resend account+domain, so this stops one environment's mail leaking into the other's dead-letter table
# EDGEX_INBOUND_ENABLED=true  # global kill switch; per-tenant tenant_email_settings.inbound_enabled must ALSO be true

# Internal cron drain routes (INTERNAL_CRON_SECRET-guarded Bearer auth, e.g.
# /api/internal/email/inbound/process, /api/internal/inbox/process).
# INTERNAL_CRON_SECRET=

# OAuth state HMAC signing (Gmail connect flow). Falls back to the anon key if unset.
# NEXTAUTH_SECRET=

# Old RKU Supabase (for one-time migration only)
OLD_SUPABASE_URL=https://ldsgsdjixzsljgkcktqu.supabase.co
OLD_SUPABASE_SERVICE_ROLE_KEY=your-old-service-role-key

# AI SDK write-tool approval signing (experimental_toolApprovalSecret)
# AI_TOOL_APPROVAL_SECRET=  # 32+ random bytes (openssl rand -hex 32); HMAC-signs AI write-tool approvals. Required when AI_WRITE_TOOLS_ENABLED=true.

# MCP server at /api/mcp (Phase 5 slice 5.5). Off => the route 404s outright. Also
# requires AI_AGENTS_ENABLED=true, a tenant with ai_enabled+ai_agents_enabled, an
# integration-category API key, and an active "mcp-client" agent identity for that tenant.
# AI_MCP_ENABLED=true

# Inngest (durable background jobs). Server-only runtime secrets — never NEXT_PUBLIC.
# Local dev: leave the keys unset, set INNGEST_DEV=1, and run `npx inngest-cli dev`.
# Stage/prod: keys are injected by the deploy pipelines; do NOT set INNGEST_DEV there.
INNGEST_DEV=1
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=

# ── Sentry (error monitoring + tracing) ────────────────────────────────────────
# NEXT_PUBLIC_* are inlined into the bundles at BUILD time — they are NOT read
# from .env.local at runtime. On stage/prod they arrive as Docker build args from
# the deploy workflows; setting them only in .env.local on the box does nothing.
# Leave the DSN unset locally and the SDK stays inert (enabled: false) — local
# errors are not reported.
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=development   # deploy sets staging | production
# NEXT_PUBLIC_SENTRY_RELEASE=                  # deploy sets the git SHA
#

# ── Advanced filters UI (docs/ADVANCED-FILTERS-BRIEF.md Phase 3) ───────────────
# Kill switch between the new field->operator->value bar and the legacy
# dropdown toolbar on the leads table. Off (unset) everywhere until sign-off.
# NEXT_PUBLIC_ADVANCED_FILTERS=1
#
# Source-map upload only (CI). SENTRY_AUTH_TOKEN is a real credential and rides a
# BuildKit secret mount in the Dockerfile, never a build arg. Without it the build
# still succeeds — it just skips source maps, so prod traces would be minified.
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# ── SMS (Aakash) — Phase 1: sending core + credit ledger, ships dark ──────────
# EdgeX owns ONE shared Aakash account; credits are a platform-owned pool
# allocated per tenant via scripts/grant-sms-credits.ts, not a per-tenant
# provider account. SMS_SANDBOX defaults to true (inverted vs the AI flags
# above) because the failure mode of getting this wrong is texting real people.
SMS_ENABLED=false
SMS_PROVIDER=mock            # mock | aakash
SMS_SANDBOX=true             # true => every send redirected to SMS_TEST_RECIPIENTS
SMS_TEST_RECIPIENTS=
AAKASH_SMS_TOKEN=            # server-only; IP-bound to the production box, do not set locally
AAKASH_SMS_BASE_URL=https://sms.aakashsms.com
